generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Live API replica — joint-table normalized per aiorbit_schema.sql:192/200
// Live JSON has arrays: categories[], tags[], useCases[], ttasks[] — mapped to join tables.
// Creativity/Personal = views on ToolCategory (no separate tables).

model Tool {
  id              String       @id
  slug            String       @unique
  name            String
  description     String       @db.Text
  logoUrl         String
  websiteUrl      String?
  pricingModel    String       // FREE | FREEMIUM | PAID
  pricingAmount   Decimal?     @db.Decimal(14, 2)
  billingFrequency String?     // MONTHLY | YEARLY | NA
  avgRating       Decimal?     @db.Decimal(5, 2)
  upvoteCount     Int          @default(0)
  isOpenSource    Boolean      @default(false)
  isTrending      Boolean      @default(false)
  verified        Boolean      @default(false)
  hasApi          Boolean      @default(false)
  launchDate      DateTime?
  releaseDate     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tags            ToolTag[]
  useCases        ToolUseCase[]
  categories      ToolCategory[]
  tTasks          ToolTTask[]
  counters        ToolCounter?

  @@index([pricingModel])
  @@index([isTrending])
  @@index([verified])
}

model ToolTag {
  toolId String
  tag    String
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)
  @@id([toolId, tag])
  @@index([tag])
}

model ToolUseCase {
  toolId  String
  useCase String
  tool    Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)
  @@id([toolId, useCase])
}

model Category {
  id    String @id
  slug  String @unique
  name  String
  tools ToolCategory[]
}

model ToolCategory {
  toolId     String
  categoryId String
  tool       Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@id([toolId, categoryId])
  @@index([categoryId])
}

model ToolTTask {
  toolId String
  taskSlug String
  title  String
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)
  @@id([toolId, taskSlug])
  @@index([taskSlug])
}

model ToolCounter {
  toolId        String @id
  tool          Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)
  bookmarksCount Int   @default(0)
  reviewsCount   Int   @default(0)
}

// Tasks — taxonomy per aiorbit_schema.sql:491
model TaskCategory {
  id    String @id
  slug  String @unique
  name  String
  tasks Task[]
}

model Task {
  id             String       @id
  slug           String       @unique
  title          String
  description    String       @db.Text
  categoryId     String
  category       TaskCategory @relation(fields: [categoryId], references: [id])
  difficulty     String
  pricingModel   String
  iconUrl        String
  isFeatured     Boolean      @default(false)
  likes          Int          @default(0)
  saves          Int          @default(0)
  subscribers    Int          @default(0)
  resourcesCount Int          @default(0)
  toolsCount     Int          @default(0)
  modelsCount    Int          @default(0)
  robotsCount    Int          @default(0)
  devicesCount   Int          @default(0)
  createdAt      DateTime?
  updatedAt      DateTime?

  @@index([categoryId])
  @@index([isFeatured])
  @@index([difficulty])
}

// Companies
model Company {
  id          String @id
  slug        String @unique
  name        String
  description String? @db.Text
  website     String?
  logoUrl     String?
  verified    Boolean @default(false)
  featured    Boolean @default(false)
  createdAt   DateTime?
  updatedAt   DateTime?
}

// Models
model Model {
  id          String  @id
  slug        String  @unique
  name        String
  description String  @db.Text
  providerId  String?
  modelType   String?
  modality    String?
  apiAvailable Boolean @default(false)
  openSource   Boolean @default(false)
  releaseDate DateTime?
  createdAt   DateTime?
}

// Devices
model Device {
  id                  String  @id
  slug                String  @unique
  name                String
  description         String  @db.Text
  category            String
  manufacturerSlug    String
  manufacturerCompanyId String?
  imageUrl            String
  country             String?
  createdAt           DateTime?
  @@index([category])
  @@index([manufacturerSlug])
}

// Robots
model Robot {
  id          String  @id
  slug        String  @unique
  name        String
  about       String  @db.Text
  category    String
  companyId   String?
  country     String
  createdAt   DateTime?
  @@index([category])
}

// Repositories
model Repository {
  id              String   @id
  slug            String   @unique
  name            String
  description     String   @db.Text
  owner           String
  url             String
  homepage        String?
  language        String?
  stars           Int      @default(0)
  forks           Int      @default(0)
  githubCreatedAt DateTime?
  syncedAt        DateTime?
  @@index([language])
  @@index([stars(sort: Desc)])
}

// MCP
model McpItem {
  id            String   @id
  slug          String   @unique
  name          String
  itemType      String?
  providerName  String?
  websiteUrl    String?
  qualityScore  Decimal? @db.Decimal(6, 2)
  createdAt     DateTime?
  updatedAt     DateTime?
}

// Search / featured snapshots
model SearchFeatured {
  id       String @id
  title    String
  slug     String
  category String
  type     String
  logoUrl  String
}
