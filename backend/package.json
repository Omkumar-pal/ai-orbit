{
  "name": "aiorbit-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "download": "node scripts/download.mjs",
    "download:tools": "node scripts/download.mjs --resource=tools",
    "seed": "node scripts/seed.mjs",
    "seed:clean": "node scripts/seed.mjs --truncate",
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "prisma": "5.22.0",
    "typescript": "latest",
    "@types/node": "latest",
    "@types/react": "latest"
  }
}
